;;; Initialisation

; in case of errors during startup
; (setq debug-on-error t)

(require 'warnings)

; Common Lisp compatibility mode
(require 'cl)

;; By default, emacs loads all installed packages at startup, which is not the best idea
(setq package-enable-at-startup nil)

;; all custom files are in .emacs.d/site-lisp or subdirs of it
(add-to-list 'load-path (expand-file-name "~/.emacs.d/site-lisp"))
(let ((default-directory (expand-file-name "~/.emacs.d/site-lisp")))
          (load (expand-file-name "subdirs.el") t t t))

(defun add-to-load-path-if-exists (dirname)
  (let ((dir (expand-file-name dirname)))
    (when (file-exists-p dir)
      (add-to-list 'load-path dir))))


;; Quicklisp is present? Then use slime either from m-creations dist or from quicklisp (default)
(setq quicklisp-home (or (getenv "QUICKLISP_HOME")
                         (when (file-exists-p "~/quicklisp")
                           "~/quicklisp")))

(when quicklisp-home
  (loop for dist in '("m-creations" "quicklisp")
        do
        (when (file-exists-p (concat quicklisp-home "/dists/" dist "/installed/systems/swank.txt"))
          (setq quicklisp-slime-helper-dist dist)
          (return)))
  (unless (boundp 'quicklisp-slime-helper-dist)
    (warn "You have no slime in your quicklisp installation at %s" quicklisp-home)))

;;; slime-docker default docker image
(setq mc-sbcl-docker-tag "1.4.11-ql-2018-08-31-mc-2018-07-24-1-g7a3112e")

(setq slime-docker-default-swank-path (expand-file-name "~/.emacs.d/site-lisp/slime"))

(setq slime-mount-path "/common-lisp/slime")

(setq mc-slime-docker-host-swank-path (file-name-directory (locate-library "slime")))

(setq slime-docker-implementations `(("sbcl-mc" ("--dynamic-space-size" "200")
                                                :slime-mount-path ,slime-mount-path
                                                :image-name "mcreations/sbcl"
                                                :image-tag ,mc-sbcl-docker-tag
                                                :mounts ((("~/common-lisp" . "/common-lisp"))
                                                         (("~/.cache" . "/cache"))
                                                         ;;  ((,mc-slime-docker-host-swank-path . ,slime-docker-default-swank-path))
                                                         ))))

;; A user-specific directory should be present in ~/.emacs.d/site-lisp/users/${USER}
(add-to-load-path-if-exists (concat "~/.emacs.d/site-lisp/m-creations/users/" (getenv "USER") "/"))

;; lisp-mode-hook is of course also used in case of Emacs Lisp buffers, but when using
;; slime-mode-hook, then it is too late to load my-slime-init
(add-hook 'lisp-mode-hook
          '(lambda ()
            (when (file-exists-p "/usr/share/doc/hyperspec/")
              (setq common-lisp-hyperspec-root "file:///usr/share/doc/hyperspec/"))
            (require 'dwim-slime)
            ;; this creates a configuration file for ASDF for using the slime/swank in this repo
            (add-emacs.d-swank-to-asdf-source-registry)
            (require 'my-slime-init "my-slime-init" t)))

;; increase the max number for variable bindings and unwind-protect
(setf max-specpdl-size 4000)

;; start emacsclient server
(server-start)

;;; system environment variables

(defun prepend-to-system-path (directory)
  (setenv "PATH" (concat directory ":" (getenv "PATH"))))

(defun my-set-home-and-add-bin-to-path (env-var-name full-path)
  "Sets env var ENV-VAR-NAME and adds its bin/ subdir to PATH"
  (setenv env-var-name full-path)
  (setenv "PATH" (concat full-path "/bin:" (getenv "PATH"))))

(prepend-to-system-path "~/.emacs.d/site-lisp/bin")

;; now load the machine specific emacs rc file, if any
(let* ((sysname (system-name))
       (machine-rc (concat "~/.emacs." sysname)))
  (if (file-exists-p machine-rc)
    (load machine-rc)
    (message "No machine specific emacs rc file for %s" sysname)))

;;; Set the PATH which is visible in emacs to the one defined in the shell startup files
;;
;; This is only relevant in graphical desktops, but can be re-executed to
;; pick up possible changes (e.g. cim, nvm changes of the default commands)

(when (and window-system (not (eq (window-system) 'w32)))
  (require 'exec-path-from-shell)
  (setq exec-path-from-shell-variables
        '("PATH" "MANPATH" "NLS_LANG"))
  (exec-path-from-shell-initialize))

