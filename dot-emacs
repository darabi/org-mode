;; jedi for python programming
(autoload 'jedi:setup "jedi" "Python autocompletion for Emacs" t)

(setq jedi:complete-on-dot t)

(add-hook 'python-mode-hook '(lambda ()
                               (require 'python-environment)
                               (setq jedi:environment-virtualenv
                                     (append python-environment-virtualenv
                                             '("--python" "python3")))
                               (jedi:setup)))

;; magit usage always starts with magit-status, so add an autoload
(autoload 'magit-status "magit" "Magit" t)

;; load the user's my-init as the last action
(require 'my-init "my-init" t)
