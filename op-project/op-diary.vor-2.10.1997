 --- noch 9 Wochen: Dudenhöfer mit "Familie Becker" im Fernsehen
&%%(let ((dayname (calendar-day-of-week date))
	 (day (extract-calendar-day date))
	 (year (extract-calendar-year date)))
     (and (= dayname 2)
	  (> (calendar-day-number date) 32)
	  (< (calendar-day-number date) 120)
	  (= year 1996))
     ).	21:00 Fernsehen: Dudenhöfer: Familie Becker im 1. Programm



--- emacs muß hier mit float-Option compiliert sein
--- alle 14 Tage, gerechnet ab dem 5.3.1996 (Tag und Monat sind im Code vertauscht) Treffen mit Marhöfer zum Klönkaffee
&%%(let* ((dayname (calendar-day-of-week date))
	  (day (extract-calendar-day date))

	  (startdate '(3 5 1996))
	  (days 14)

	  (diffbetweendays (float
			    ( - 
			      (+ (calendar-day-number date)
				 (truncate (+ (* 365.24
						 (- (extract-calendar-year date)
						    (extract-calendar-year startdate)
						    )) .9)))
			      (calendar-day-number startdate))))
	  (modulobetweendays ( * ( - (/ diffbetweendays days) (truncate (/ diffbetweendays days))) days)))
	  (and
	    (>= diffbetweendays -0.0001)	
	    (< modulobetweendays 0.0001))
     ).	15:30 R: Klönkaffee zum Infoaustausch mit Marhöfer



 --- jeden 2. Mittwoch im Monat: BUND-Stammtisch
  &%%(let ((dayname (calendar-day-of-week date))
  	 (day (extract-calendar-day date)))
      (and (memq day '(7 8 9 10 11 12 13)) (= dayname 3))
      ).	20:00 R: BUND-Stammtisch im Cafe Nixda 

 --- jeden 4. Montag im Monat: BUND-Kreisgruppentreffen
&%%(let ((dayname (calendar-day-of-week date))
	 (day (extract-calendar-day date)))
     (and (memq day '(22 23 24 25 26 27 28)) (= dayname 1))
     ).	20:00 R: BUND-Kreisgruppentreffen in der Landesgeschäftsstelle



 --- jeden 1. Mittwoch im Monat: Notstromtests in der Klinik
&%%(let ((dayname (calendar-day-of-week date))
	 (day (extract-calendar-day date)))
     (and (memq day '(1 2 3 4 5 6 7)) (= dayname 3))
     ).	14:40 R: *** !!! Nachmittags Notstromtests an der Uniklinik --- Maschinen runterfahren !!! ***



 --- 1. Wochenende im November: Hochheimer Markt
&%%(let ((dayname (calendar-day-of-week date))
	 (day (extract-calendar-day date))
	 (month (extract-calendar-month date)))
     (and (= month 11)
	  (memq day '(1 2 3 4 5 6 7))
	  (or (= dayname 0)
	      (= dayname 6)))
     ).	Hochheimer Bauernmarkt - feine Sache bis Dienstag








 ---- Kommentar
	 For example, the following diary entry will apply to the 21st of the month
	 if it is a weekday and the Friday before if the 21st is on a weekend:

	 -- &%%(let ((dayname (calendar-day-of-week date))
	       (day (extract-calendar-day date)))
	   (or
	     (and (= day 21) (memq dayname '(1 2 3 4 5)))
	     (and (memq day '(19 20)) (= dayname 5)))
	 ) UIUC pay checks deposited






